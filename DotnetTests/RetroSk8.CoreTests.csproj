<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the engine-free Core logic and the EditMode tests outside Unity (CI / no-editor sanity check).
    Uses a minimal NUnit-compatible shim + reflection runner so it needs no NuGet access.
    Inside Unity the same test files run under the real Unity Test Framework (NUnit).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/RetroSk8/Scripts/Core/**/*.cs" />
    <Compile Include="../Assets/RetroSk8/Tests/EditMode/**/*.cs" />
    <Compile Include="NUnitShim.cs" />
    <Compile Include="Runner.cs" />
  </ItemGroup>
</Project>
